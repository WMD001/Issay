# 可选：GitHub Personal Access Token（仅用于提高读取限额或访问私有仓库；公开仓库可留空）
GITHUB_TOKEN=

# GitHub 用户名（用于判断管理员身份）
GITHUB_OWNER=your-username

# 存放说说的仓库，必须为 owner/repo 全名
GITHUB_REPO=your-username/your-repo

# NextAuth 密钥（openssl rand -base64 32 生成）
NEXTAUTH_SECRET=your-secret-here

# GitHub OAuth App
# 回调地址：http(s)://你的域名/api/auth/callback/github
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# NextAuth URL（生产环境为你的域名，必须以 https:// 开头）
NEXTAUTH_URL=http://localhost:3000